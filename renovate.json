{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>codefloe/renovate-config"
  ],
  "automergeType": "pr",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.forgejo/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*\\w+:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ]
}
